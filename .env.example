# ── Site ──────────────────────────────────────────────────────────────────────
# Public URL, no trailing slash. Used for canonical URLs, sitemap and share links.
NEXT_PUBLIC_SITE_URL=https://satyasri.com
# Optional Google Analytics 4 Measurement ID (G-XXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Supabase (listings, blog, reviews, leads, admin login, image storage) ────
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-host
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to store leads. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Lead notifications (each is optional; a lead is kept if any channel works) ─
# Telegram: create a bot with @BotFather, send it a message, read chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets: service account with the Sheets API enabled; share the sheet
# with the service account email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
# Optional, defaults to Sheet1!A:L
GOOGLE_SHEET_RANGE=

# Email via Resend (domain must be verified in Resend).
RESEND_API_KEY=
RESEND_FROM=SatyaSri Realtors <leads@mail.satyasri.com>
# Comma-separated list of inboxes that receive new-lead emails.
RESEND_TO=
